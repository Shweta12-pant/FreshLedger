{
  "uid": "freshledger-ops",
  "title": "FreshLedger operations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "inventory",
    "operations"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "API scrape status",
      "type": "stat",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"freshledger\"}",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Database status",
      "type": "stat",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "freshledger_database_up",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Products forecast",
      "type": "stat",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "freshledger_forecast_products",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Time since last forecast",
      "type": "stat",
      "gridPos": {
        "w": 6,
        "h": 5,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (freshledger_forecast_last_success_timestamp_seconds > 0)",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "HTTP requests by status",
      "type": "timeseries",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(freshledger_http_requests_total[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "95th percentile request duration",
      "type": "timeseries",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(freshledger_http_duration_seconds_bucket[5m])))",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "API errors per second",
      "type": "timeseries",
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "freshledger-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(freshledger_http_requests_total{status=~\"5..\"}[5m])) or (0 * up{job=\"freshledger\"})",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
