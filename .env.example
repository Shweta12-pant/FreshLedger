# Defaults launch an isolated demo on loopback.
SEED_DEMO=1
INVENTORY_TIMEZONE=Asia/Kolkata
MYSQL_DATABASE=freshledger
MYSQL_USER=freshledger
MYSQL_PASSWORD=freshledger-demo
MYSQL_ROOT_PASSWORD=freshledger-demo-root
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=freshledger-demo
# Optional. Set both to require authentication for the UI and writable API.
APP_USERNAME=
APP_PASSWORD=
